# =============================================================================
# Variables de entorno — valores de ejemplo (todos vacíos)
# NOTA: La clave privilegiada (SUPABASE_SECRET_KEY) debe rotarse en Supabase
# Dashboard antes de cualquier deploy a producción.
# Copiar a supabase/.env.local y rellenar valores reales (nunca commitear).
# =============================================================================

# Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=   # antes: anon key (segura para el cliente)
SUPABASE_SECRET_KEY=        # antes: service_role key — NUNCA exponer al cliente

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
META_GRAPH_API_VERSION=
WHATSAPP_FLOW_ID=

# Seguridad interna (min 32 chars, generar con crypto.randomUUID())
INTERNAL_FUNCTION_SECRET=

# Google OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=   # URL de google-oauth-callback, ej. https://<project>.supabase.co/functions/v1/google-oauth-callback
GOOGLE_OAUTH_STATE_SECRET=   # min 32 chars para HMAC del state (generar con crypto.randomUUID())

# Google Calendar Sync
GOOGLE_CALENDAR_SYNC_URL=    # URL de google-calendar-sync, ej. http://localhost:54321/functions/v1/google-calendar-sync
GOOGLE_TOKEN_ENDPOINT=       # override para tests; producción: https://oauth2.googleapis.com/token
GOOGLE_CALENDAR_API_BASE_URL= # override para tests; producción: https://www.googleapis.com/calendar/v3
